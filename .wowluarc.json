{
  "$schema": "https://raw.githubusercontent.com/TradeSkillMaster/wowlua-ls/v0.32.1/editors/vscode/wowluarc.schema.json",
  "flavors": ["retail"],
  "ignore": ["tests/"],
  "diagnostics": {
    "enable": [
      "need-check-nil",
      "invalid-op",
      "nil-index",
      "implicit-nil-return",
      "unused-vararg",
      "redundant-or",
      "redundant-and"
    ]
  }
}
