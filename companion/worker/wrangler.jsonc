{
  "name": "arbitrage-worker",
  "main": "build/index.js",
  "compatibility_date": "2026-09-23",
  "build": {
    "command": "cargo install --locked -q \"worker-build@0.8.6\" && worker-build --release"
  },
  "triggers": {
    "crons": ["10 */3 * * *", "30 1,13 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_SESSIONS",
        "class_name": "AuthSession"
      },
      {
        "name": "ACCOUNT_DATABASES",
        "class_name": "AccountDatabase"
      },
      {
        "name": "MARKET_DATABASES",
        "class_name": "MarketDatabase"
      },
      {
        "name": "REGION_DATABASES",
        "class_name": "RegionDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountDatabase"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MarketDatabase"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["RegionDatabase"]
    }
  ],
  "env": {
    "staging": {
      "name": "arbitrage-worker-staging",
      "triggers": {
        "crons": ["40 4,10,16,22 * * *", "30 7 * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_SESSIONS",
            "class_name": "AuthSession"
          },
          {
            "name": "ACCOUNT_DATABASES",
            "class_name": "AccountDatabase"
          },
          {
            "name": "MARKET_DATABASES",
            "class_name": "MarketDatabase"
          },
          {
            "name": "REGION_DATABASES",
            "class_name": "RegionDatabase"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthSession"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["AccountDatabase"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["MarketDatabase"]
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["RegionDatabase"]
        }
      ]
    },
    "production": {
      "name": "arbitrage-worker",
      "workers_dev": false,
      "routes": [{ "pattern": "arbitrage-wow.fyi", "custom_domain": true }],
      "triggers": {
        "crons": ["10 */3 * * *", "30 1,13 * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_SESSIONS",
            "class_name": "AuthSession"
          },
          {
            "name": "ACCOUNT_DATABASES",
            "class_name": "AccountDatabase"
          },
          {
            "name": "MARKET_DATABASES",
            "class_name": "MarketDatabase"
          },
          {
            "name": "REGION_DATABASES",
            "class_name": "RegionDatabase"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthSession"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["AccountDatabase"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["MarketDatabase"]
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["RegionDatabase"]
        }
      ]
    }
  }
}
