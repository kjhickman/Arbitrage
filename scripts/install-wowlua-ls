#!/bin/sh

set -eu

version="v0.32.1"
platform="$(uname -s)"
architecture="$(uname -m)"

case "$platform/$architecture" in
  Darwin/arm64)
    asset="wowlua_ls-aarch64-apple-darwin"
    checksum="48bfd125a2e2df4f40641ffa2f091a7f5a4ee4185843a84e735e7614b046b3da"
    ;;
  Darwin/x86_64)
    asset="wowlua_ls-x86_64-apple-darwin"
    checksum="7bb57c2b6dfcf0296b65c1480c93c9b18bf56cd50fac07e90b463f525a7287ee"
    ;;
  Linux/x86_64)
    asset="wowlua_ls-x86_64-unknown-linux-gnu"
    checksum="249be271b698b44e41fc4496316ae170c1eca2461ce7863a6d5c83ec680f4484"
    ;;
  *)
    echo "Unsupported platform: $platform/$architecture" >&2
    exit 1
    ;;
esac

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
project_dir="$(CDPATH= cd -- "$script_dir/.." && pwd)"
install_dir="$project_dir/.tools"
temporary_file="$(mktemp "${TMPDIR:-/tmp}/wowlua_ls.XXXXXX")"
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM

curl --fail --location --output "$temporary_file" \
  "https://github.com/TradeSkillMaster/wowlua-ls/releases/download/$version/$asset"

if command -v sha256sum >/dev/null 2>&1; then
  actual_checksum="$(sha256sum "$temporary_file" | awk '{print $1}')"
else
  actual_checksum="$(shasum -a 256 "$temporary_file" | awk '{print $1}')"
fi

if [ "$actual_checksum" != "$checksum" ]; then
  echo "Checksum verification failed for $asset" >&2
  exit 1
fi

mkdir -p "$install_dir"
mv "$temporary_file" "$install_dir/wowlua_ls"
chmod 755 "$install_dir/wowlua_ls"
trap - EXIT HUP INT TERM

echo "Installed wowlua-ls $version to $install_dir/wowlua_ls"
