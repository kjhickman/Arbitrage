#!/bin/sh

# Classify a set of changed paths. Reads one repo-relative path per line on stdin.
#
# By default, decides what a tag should ship and prints addon=, companion=, and
# worker=true|false. The addon set matches what BigWigs packager ships: every
# non-dot path, except the .pkgmeta ignore list. .pkgmeta itself counts, because
# it changes the package. The companion and worker sets are their build and
# deploy inputs.
#
# With --checks, decides which CI checks a change needs and prints lua=,
# companion=, and worker=true|false. Workflow changes run every check.

set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

ignore_entries="$(
  awk '
    /^ignore:/ { ignoring = 1; next }
    ignoring && /^[^[:space:]#]/ { exit }
    ignoring && /^[[:space:]]*-[[:space:]]*/ {
      sub(/\r$/, "")
      sub(/^[[:space:]]*-[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      gsub(/^["'\'']|["'\'']$/, "")
      if (length($0) > 0) print
    }
  ' "$root/.pkgmeta"
)"

affects_addon() {
  file=$1
  if [ "$file" = ".pkgmeta" ]; then
    return 0
  fi
  case $file in
    .* | */.*) return 1 ;;
  esac

  old_ifs=$IFS
  IFS='
'
  for entry in $ignore_entries; do
    case $file in
      "$entry" | "$entry"/*)
        IFS=$old_ifs
        return 1
        ;;
    esac
  done
  IFS=$old_ifs
  return 0
}

affects_companion() {
  case $1 in
    companion/app/tests | companion/app/tests/*) return 1 ;;
    companion/app | companion/app/*) return 0 ;;
    companion/shared | companion/shared/*) return 0 ;;
    companion/Cargo.toml | companion/Cargo.lock) return 0 ;;
    companion/scripts/package-macos | companion/scripts/package-windows.ps1) return 0 ;;
    rust-toolchain.toml | .github/workflows/build-companion.yml) return 0 ;;
  esac
  return 1
}

affects_worker() {
  case $1 in
    companion/worker | companion/worker/*) return 0 ;;
    companion/shared | companion/shared/*) return 0 ;;
    companion/Cargo.toml | companion/Cargo.lock) return 0 ;;
    rust-toolchain.toml | .github/workflows/deploy-worker.yml) return 0 ;;
  esac
  return 1
}

checks_lua() {
  case $1 in
    .github/*) return 0 ;;
    companion | companion/* | rust-toolchain.toml) return 1 ;;
  esac
  return 0
}

checks_companion() {
  case $1 in
    .github/* | rust-toolchain.toml) return 0 ;;
    companion/worker | companion/worker/*) return 1 ;;
    companion/*) return 0 ;;
  esac
  return 1
}

checks_worker() {
  case $1 in
    .github/* | rust-toolchain.toml) return 0 ;;
    companion/app | companion/app/* | companion/scripts/*) return 1 ;;
    companion/*) return 0 ;;
  esac
  return 1
}

# Usage: classify PREFIX NAME... prints NAME=true for each NAME whose
# PREFIX_NAME predicate matches any path on stdin.
classify() {
  prefix=$1
  shift
  matched=' '
  while IFS= read -r file || [ -n "$file" ]; do
    file=${file%$(printf '\r')}
    [ -n "$file" ] || continue
    for name in "$@"; do
      if "${prefix}_$name" "$file"; then
        case $matched in
          *" $name "*) ;;
          *) matched="$matched$name " ;;
        esac
        echo "$name: $file" >&2
      fi
    done
  done
  for name in "$@"; do
    case $matched in
      *" $name "*) printf '%s=true\n' "$name" ;;
      *) printf '%s=false\n' "$name" ;;
    esac
  done
}

classify_release() {
  classify affects addon companion worker
}

classify_checks() {
  classify checks lua companion worker
}

self_test() {
  assert() {
    mode=$1
    expected=$2
    shift 2
    if [ "$#" -eq 0 ]; then
      actual=$("$mode" </dev/null 2>/dev/null)
    else
      actual=$(printf '%s\n' "$@" | "$mode" 2>/dev/null)
    fi
    if [ "$actual" != "$expected" ]; then
      printf 'release-affected: %s expected [%s] for [%s], got [%s]\n' "$mode" "$expected" "$*" "$actual" >&2
      exit 1
    fi
  }

  assert classify_release "$(printf 'addon=false\ncompanion=false\nworker=false\n')"
  assert classify_release "$(printf 'addon=true\ncompanion=false\nworker=false\n')" \
    src/Main.lua Arbitrage.toc LICENSE libs/LibAHTab/LibAHTab.lua
  assert classify_release "$(printf 'addon=true\ncompanion=false\nworker=false\n')" .pkgmeta
  assert classify_release "$(printf 'addon=false\ncompanion=false\nworker=false\n')" \
    README.md libs/LibAHTab/README.md tests/Main_test.lua tests/support/AuctionHouseHarness.lua \
    scripts/install-wowlua-ls scripts/release-affected \
    companion/scripts/install-macos companion/scripts/render-icons companion/rustfmt.toml \
    justfile opencode.json .github/workflows/release.yml .gitattributes src/.keep
  assert classify_release "$(printf 'addon=false\ncompanion=true\nworker=false\n')" \
    companion/app/src/main.rs companion/scripts/package-macos companion/scripts/package-windows.ps1 \
    .github/workflows/build-companion.yml
  assert classify_release "$(printf 'addon=false\ncompanion=true\nworker=true\n')" \
    companion/shared/src/lib.rs companion/Cargo.toml companion/Cargo.lock rust-toolchain.toml
  assert classify_release "$(printf 'addon=false\ncompanion=false\nworker=true\n')" \
    companion/worker/src/lib.rs companion/worker/wrangler.jsonc .github/workflows/deploy-worker.yml
  assert classify_release "$(printf 'addon=false\ncompanion=false\nworker=false\n')" \
    companion/app/tests/fixtures/Arbitrage.lua
  assert classify_release "$(printf 'addon=true\ncompanion=true\nworker=false\n')" \
    src/Scan.lua companion/app/windows/installer.iss

  assert classify_checks "$(printf 'lua=false\ncompanion=false\nworker=false\n')"
  assert classify_checks "$(printf 'lua=true\ncompanion=false\nworker=false\n')" \
    src/Main.lua tests/Main_test.lua README.md scripts/release-affected .pkgmeta justfile
  assert classify_checks "$(printf 'lua=false\ncompanion=true\nworker=false\n')" \
    companion/app/src/main.rs companion/app/tests/fixtures/Arbitrage.lua companion/scripts/install-macos
  assert classify_checks "$(printf 'lua=false\ncompanion=false\nworker=true\n')" \
    companion/worker/src/lib.rs companion/worker/wrangler.jsonc
  assert classify_checks "$(printf 'lua=false\ncompanion=true\nworker=true\n')" \
    companion/shared/src/lib.rs companion/Cargo.lock companion/rustfmt.toml rust-toolchain.toml
  assert classify_checks "$(printf 'lua=true\ncompanion=true\nworker=true\n')" .github/workflows/ci.yml
  echo "release-affected: ok"
}

case "${1:-}" in
  --test) self_test ;;
  --checks) classify_checks ;;
  *) classify_release ;;
esac
