{
  "$schema": "https://raw.githubusercontent.com/TradeSkillMaster/wowlua-ls/v0.33.1/editors/vscode/wowluarc.schema.json",
  "flavors": ["forever"],
  "ignore": ["tests/", "companion/", ".tools/"],
  "library": ["libs/"],
  "globals": {
    "read": ["ARBITRAGE_IMPORT"]
  },
  "diagnostics": {
    "enable": [
      "need-check-nil",
      "invalid-op",
      "nil-index",
      "implicit-nil-return",
      "unused-vararg",
      "redundant-or",
      "redundant-and"
    ]
  }
}
